# ---------------------------------------------------------------------------
# Enquiry form email delivery (Resend — https://resend.com)
# ---------------------------------------------------------------------------
# Without RESEND_API_KEY the form still works: submissions are validated and
# logged to the server console instead of being emailed. Set the key before
# launch so real enquiries reach the inbox.

RESEND_API_KEY=

# Where enquiries are delivered. Defaults to info@yirehstitchtech.com.
ENQUIRY_TO_EMAIL=info@yirehstitchtech.com

# The "from" address. Must be on a domain verified in Resend.
# Verify yirehstitchtech.com in Resend, then use something like:
#   ENQUIRY_FROM_EMAIL="Yireh Textiles Website <website@yirehstitchtech.com>"
# Note: verifying a sending subdomain in Resend does NOT affect the existing
# GoDaddy mailbox on info@yirehstitchtech.com.
ENQUIRY_FROM_EMAIL=
